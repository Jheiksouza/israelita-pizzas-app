# === VARIÁVEIS ESSENCIAIS (Obrigatórias) ===
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Multi-tenant: store padrão para desenvolvimento local (ID da Israelita = 1)
DEFAULT_STORE_ID=1

# JWT - Obrigatório em produção (Vercel). Gerar no terminal: 
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=gerar-uma-chave-aleatoria-32-bytes

# === VARIÁVEIS OPCIONAIS (Apenas para desenvolvimento local) ===
# ⚠️  NÃO exponha essas credenciais! Nunca commitar no git!
# Usar APENAS em .env local, e apenas se precisar fazer queries SQL avançadas

# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
# SUPABASE_PAT=seu-personal-access-token

# === VARIÁVEIS OPCIONAIS (Google OAuth) ===
# GOOGLE_CLIENT_ID=seu-google-client-id
# GOOGLE_CLIENT_SECRET=seu-google-client-secret
